{
  "name": "clashpanel",
  "version": "1.0.0",
  "description": "CWL planning, operation tracking, groups, polls and tournament tools for Clash of Clans.",
  "scripts": {
    "dev": "node scripts/serve-static.mjs",
    "build": "node scripts/build-static.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "check": "npm run check:migrations && npm run check:endpoints && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Watahman/Clash_Project.git"
