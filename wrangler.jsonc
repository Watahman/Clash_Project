{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clashpanel",
  "compatibility_date": "2026-07-24",
  "main": "./worker/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "clashpanel.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/dashboard*",
      "/app/*",
      "/subpages/*",
      "/subPages/*",
      "/cwl-planner*",
      "/cwl-tracker*",
      "/clan-management*",
      "/bracket-generator*"
    ]
  },

  "vars": {
    "CLOUD_RUN_ORIGIN": "https://clashpanel-api-982136486076.europe-west1.run.app"
  }
}
