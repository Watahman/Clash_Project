# Do not commit real secrets. Copy this file to .env locally or set the variables in your IDE/terminal.
_BASE_URL_SUPABASE=https://your-project.supabase.co
_API_KEY_SUPABASE=your_supabase_publishable_or_anon_key
_API_KEY_SECR_SUPABASE=your_supabase_service_role_secret
_BASE_URL_CLASH=https://api.clashofclans.com/v1
_API_KEY_ALL=Bearer your_clash_of_clans_api_token

# Frontend (Vite)
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Server and browser access
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BODY_BYTES=1048576

# Cache and abuse protection
CACHE_ENABLED=true
CACHE_MODE=layered
PUBLIC_RATE_LIMIT_PER_MINUTE=90
SENSITIVE_RATE_LIMIT_PER_MINUTE=10
DATA_RATE_LIMIT_PER_MINUTE=180
