# Supabase server configuration
SUPABASE_URL=https://your-project-ref.supabase.co
_API_KEY_SUPABASE=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Clash of Clans API request behavior
CLASH_API_RATE_LIMIT_COOLDOWN_SECONDS=60
CLASH_API_MAX_COOLDOWN_SECONDS=300

# ClashKing V2 historical player performance and CWL history
CLASHKING_BASE_URL=https://api.clashk.ing
# Optional Unix epoch-seconds override. Leave blank to discover the current
# ranked season automatically from ClashKing V2 /v2/dates/current.
CLASHKING_RANKED_SEASON=
# Opt-in fallback for the official rolling normal battle log only.
CLASHKING_FALLBACK_TO_OFFICIAL=false
# Console report interval for real outbound ClashKing requests.
CLASHKING_COUNTER_INTERVAL_SECONDS=60

# Local server and browser origins
SERVER_PORT=8080
PUBLIC_SITE_URL=https://replace-with-production-domain.example
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=34560000
AUTH_EMAIL_CONFIRM_REDIRECT_URL=http://localhost:5173/subpages/login.html
AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/subpages/login.html
AUTH_GOOGLE_CALLBACK_URL=http://localhost:5173/api/AuthGoogleCallback

# Set to true only when the Java API is behind a trusted reverse proxy.
# In production, configure the same strong API_PROXY_SECRET in Cloudflare and Cloud Run.
TRUST_PROXY_HEADERS=false
API_PROXY_SECRET=

# Request limits
MAX_REQUEST_BODY_BYTES=1048576
PUBLIC_RATE_LIMIT_PER_MINUTE=90
SENSITIVE_RATE_LIMIT_PER_MINUTE=10
DATA_RATE_LIMIT_PER_MINUTE=180

# Optional product analytics. Keep Development and Production projects separated.
POSTHOG_ENABLED=false
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=replace_with_posthog_project_api_key
CLASHPANEL_ENVIRONMENT=development
# Comma-separated internal ClashPanel profile IDs; never use IP addresses.
POSTHOG_INTERNAL_USER_IDS=

# Public Clash response cache
CACHE_ENABLED=true
CACHE_MODE=layered
CACHE_DB_PATH=data/cache/clashtools-cache.db
CACHE_MEMORY_MAX_ENTRIES=5000
CACHE_DISK_MAX_ENTRIES=25000
