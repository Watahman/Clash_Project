{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clashpanel-phase8-preview",
  "compatibility_date": "2026-07-24",
  "main": "./worker/index.js",
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/dashboard*",
      "/app/*",
      "/subpages/*",
      "/subPages/*",
      "/cwl-planner*",
      "/cwl-tracker*",
      "/clan-management*",
      "/bracket-generator*",
      "/guides*",
      "/methodology*",
      "/changelog*"
    ]
  },

  "vars": {
    "CLOUD_RUN_ORIGIN": "https://phase8---clashpanel-api-rxco3fz7da-ew.a.run.app",
    "DISABLE_CANONICAL_REDIRECT": "true",
    "UPSTREAM_ORIGIN_OVERRIDE": "https://clashpanel.com"
  },

  "secrets": {
    "required": ["API_PROXY_SECRET"]
  }
}
